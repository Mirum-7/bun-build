{
  "name": "@mirum7/bun-build",
  "version": "1.5.4",
  "description": "A simple build tool for Bun",
  "module": "dist/index.js",
  "type": "module",
  "exports": {
    ".": {
      "types": "./types/types.d.ts"
    },
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mirum-7/bun-build.git"
  },
  "private": false,
  "bin": {
    "bun-build": "./dist/index.js"
  },
  "scripts": {
    "build": "bun src/index.ts && bunx --bun tsc",
    "prepublishOnly": "bun run build",
    "biome:check": "biome check --write --reporter=summary"
  },
  "types": "types/types.d.ts",
  "files": ["types/**/*.d.ts", "dist/index.js", "skills/**"],
  "keywords": ["bun", "build", "bundler", "typescript"],
  "author": "mirum7",
  "license": "ISC",
  "devDependencies": {
    "@biomejs/biome": "2.4.10",
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
